# ── PostgreSQL (docker-compose) ────────────────────────────────
POSTGRES_DB=nexcomerce
POSTGRES_USER=nexcomerce
POSTGRES_PASSWORD=nexcomerce_dev
POSTGRES_PORT=5432

# ── Backend (src/NexComerce.Api) ───────────────────────────────
# Development uses the in-memory database. For PostgreSQL set:
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=Postgres
ConnectionStrings__Default=Host=localhost;Port=5432;Database=nexcomerce;Username=nexcomerce;Password=nexcomerce_dev

# Generate strong values before deploying:
#   Jwt__Key: at least 64 random characters
#   WhatsApp__EncryptionKey: at least 32 random characters
Jwt__Key=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_WITH_AT_LEAST_64_CHARACTERS_FOR_PRODUCTION_2026
WhatsApp__EncryptionKey=CHANGE_THIS_ENCRYPTION_KEY_FOR_WHATSAPP_TOKENS_IN_PRODUCTION

# Public base URL used for WhatsApp webhook hints (optional)
App__PublicUrl=

# Seed demo data on first run (true/false)
Seed__Enabled=false

# ── WhatsApp Cloud API / AI (optional) ─────────────────────────
# Global fallbacks. Each business can connect its own WABA from the app.
WhatsApp__AiApiKey=
WhatsApp__AiModel=gpt-4o-mini
WhatsApp__AiBaseUrl=https://api.openai.com/v1
WhatsApp__GraphBaseUrl=https://graph.facebook.com/v21.0

# ── Frontend (frontend/) ───────────────────────────────────────
# Leave empty when using the Vite proxy or serving the SPA from the API.
VITE_API_URL=
